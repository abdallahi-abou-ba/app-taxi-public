# Copy to .env.development.local (not .env.local!) to reach a locally
# running backend on a different port during `npm run dev`. The
# .env.development.local name matters: Vite only loads it in development
# mode, whereas a plain .env.local loads for every mode including
# `vite build` - that footgun once baked this localhost URL straight into a
# production admin bundle, breaking every fetch() in prod ("Failed to
# fetch") - so never rename this back to .env.local.
#
# Production builds need this set too, but as a real env var in the admin's
# Vercel project settings (not this file): the admin is deployed as its own
# standalone Vercel project now, no longer served same-origin from the
# backend, so it needs the backend's absolute Vercel URL here rather than a
# blank/relative value.
VITE_API_BASE_URL=http://localhost:3000
